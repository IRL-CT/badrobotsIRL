#!/bin/bash
#SBATCH -J head_rebA
#SBATCH -o training_outputs/head_rebA%j.out
#SBATCH -e training_outputs/head_rebA%j.err
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=mb2554@cornell.edu
#SBATCH -N 1
#SBATCH -n 4
#SBATCH --mem=128gb
#SBATCH -t 24:00:00
#SBATCH --partition=default_partition
#SBATCH --requeue

# HRI'27 rebuttal, headline configs 10-12 and 16 (see run_headline.py HEADLINE):
#  10 exact splendid-sweep-136 (T5: recovery delay on the best model)
#  11 exact true-sweep-651     (T10: absolute-state stage confusion matrix)
#  12, 16 the same two with SMOTE off (T3)
# Separate output registry so the published headline_predictions.csv is untouched.
# Resumable: skips run_names already present in the --out file.
PYBIN=/share/ju/conda_virtualenvs/badidea/bin/python3
export WANDB__SERVICE_WAIT=300
cd "$SLURM_SUBMIT_DIR" || exit 1
mkdir -p training_outputs rebuttal

"$PYBIN" run_headline.py --only 10 11 12 16 --out rebuttal/headline_predictions_rebuttal_A.csv
